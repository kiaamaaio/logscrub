{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git merge *)",
      "Bash(git * merge *)",
      "Bash(./scripts/go get *)",
      "Bash(scripts/go get *)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Edit(/scripts/claude-commit-check)",
      "Edit(/scripts/doc-size-check)",
      "Edit(/scripts/go)",
      "Edit(/scripts/allowed-modules)",
      "Edit(/CLAUDE.md)",
      "Edit(/go.mod)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git * push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git * commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git * commit -n*)",
      "Edit(/docs/plans/v1.0.0.md)",
      "Edit(/docs/plans/v1.0.0/**)",
      "Edit(/docs/plans/v1.1.0.md)",
      "Edit(/docs/plans/v1.1.0/**)",
      "Edit(/docs/plans/v1.2.0.md)",
      "Edit(/docs/plans/v1.2.0/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/claude-commit-check",
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "コミット前の確認を実行中..."
          }
        ]
      }
    ]
  }
}
