#!/usr/bin/env bash
# Claude Code の PreToolUse hook(.claude/settings.json)から呼ばれる。
# 検査そのものは git の pre-commit hook(.githooks/pre-commit)が行う。
# ここでは、Claude が Bash で git commit を実行する前に、その hook が有効かを確かめ、
# 有効でなければ終了コード 2 でコミットを止める(stderr は Claude に返る)。
# 標準入力は hook の入力(JSON)。git commit を含まないコマンドは何もせず通す。
set -uo pipefail

input="$(cat)"

# JSON を解析せず、コマンド文字列に「git commit」(git -C <dir> commit も含む)があるかだけを見る
if ! grep -Eq '(^|[^[:alnum:]_-])git[[:space:]]+(-C[[:space:]]+[^[:space:]]+[[:space:]]+)?commit([[:space:]]|\\|"|$)' <<<"$input"; then
  exit 0
fi

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ "$(git -C "$repo" config core.hooksPath)" != ".githooks" ]; then
  printf 'コミットを中止しました: git の pre-commit hook が有効ではありません。\n次を実行してください: git config core.hooksPath .githooks\n' >&2
  exit 2
fi

exit 0
